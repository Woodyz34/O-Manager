Differences in the brown colour shall be used to show differences in the traffic of vehicles or pedestrians.</description><line_symbol color="21" line_width="2500" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="4000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="2000" break_length="250" dashes_in_group="1" in_group_break_length="500" mid_symbols_per_spot="1" mid_symbol_distance="0"><borders><border color="22" width="100" shift="50"/></borders></line_symbol></symbol>
