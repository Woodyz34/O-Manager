Minimum depth: 0.5 m.
Footprint: 4.4 m x 5.0 m.</description><point_symbol inner_radius="900" inner_color="-1" outer_width="0" outer_color="-1" elements="1"><element><symbol type="4" code=""><area_symbol inner_color="8" min_area="0" patterns="0"/></symbol><object type="1"><coords count="6">-546 -409;-274 -409;0 217;274 -409;546 -409;0 841;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol>
